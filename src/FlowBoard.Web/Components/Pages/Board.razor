@page "/boards/{BoardId}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@implements IAsyncDisposable
@using FlowBoard.Application.DTOs
@using FlowBoard.Application.Interfaces
@using FlowBoard.Infrastructure.Data
@using FlowBoard.Web.Hubs
@using FlowBoard.Web.Services
@using FlowBoard.Web.Models
@using FlowBoard.Web.Components.UI
@inject IBoardService BoardService
@inject BoardUpdateNotifier BoardUpdates
@inject AppActionDispatcher AppActions
@inject ILogger<Board> Logger
@inject IJSRuntime JS

<PageTitle>@(BoardData?.Name ?? "Board") - FlowBoard</PageTitle>

@if (BoardData is null)
{
    if (IsLoading)
    {
        <section class="placeholder-page">
            <p>Loading board...</p>
        </section>
    }
    else
    {
        <section class="placeholder-page">
            <p class="eyebrow">Error</p>
            <h2>Board not found</h2>
            <p>We couldn't find board <strong>@BoardId</strong>.</p>
        </section>
    }
}
else
{
    <div class="section-heading compact">
        <div>
            <p class="eyebrow">Board</p>
            <h2>@BoardData.Name</h2>
            @if (!string.IsNullOrEmpty(BoardData.Description))
            {
                <p style="margin: 0; color: #65717a; font-size: 0.9rem;">@BoardData.Description</p>
            }
        </div>
        <div class="board-header-actions">
            <PresenceAvatarStack Users="ActiveUsers" />
            <ConnectionStatusBadge State="ConnectionState" />
            <button type="button" class="btn btn-outline-secondary" style="padding: 0.5rem 1rem; font-size: 0.9rem;" @onclick="ToggleReplay">
                @(ShowReplayPanel ? "Close Replay" : "⏱ Replay")
            </button>
            <button type="button" class="btn btn-primary" style="padding: 0.5rem 1rem; font-size: 0.9rem;">Board Settings</button>
        </div>
    </div>

    <section class="board-workspace">
        <div class="board-main-content" style="display: flex; flex-direction: column; gap: 1rem;">
            <div class="board-guidance" role="note">
                <span class="guidance-icon" aria-hidden="true">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                        <path d="M3 4h10M3 8h10M3 12h10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                    </svg>
                </span>
                <span>Drag cards between columns to update status and record board activity.</span>
            </div>

            <TaskFilterBar BoardMembers="BoardMembers" OnFilterChanged="HandleFilterChanged" />

            <div class="kanban-preview board-kanban">
                @foreach (var col in BoardData.Columns.OrderBy(c => c.SortOrder))
                {
                    var filteredTasks = GetFilteredTasks(col).ToList();
                    <BoardColumn Column="col" TaskCount="filteredTasks.Count" OnDrop="HandleDropAsync">
                        @foreach (var task in filteredTasks)
                        {
                            <TaskCard @key="task.Id" Task="task" OnDragStart="HandleDragStart" OnClick="() => OpenTaskDrawer(task.Id)" />
                        }
                    </BoardColumn>
                }
            </div>
        </div>

        <aside class="board-activity-panel" aria-label="Board activity">
            <header>
                <p class="eyebrow">Live activity</p>
                <h3>Board pulse</h3>
            </header>

            @if (RecentActivity.Count == 0)
            {
                <p class="activity-empty">No activity recorded yet.</p>
            }
            else
            {
                <ol class="board-activity-list">
                    @foreach (var activity in RecentActivity)
                    {
                        <li @key="activity.Id">
                            <span class="activity-avatar">@GetInitials(activity.ActorName)</span>
                            <div>
                                <p>@activity.Summary</p>
                                <small>@activity.ActorName - @FormatRelativeTime(activity.CreatedAtUtc)</small>
                            </div>
                        </li>
                    }
                </ol>
            }
        </aside>
    </section>

    <TaskDrawer @ref="taskDrawer" OnTaskSaved="HandleTaskSavedAsync" OnFieldFocused="HandleTaskFieldFocusedAsync" OnFieldBlurred="HandleTaskFieldBlurredAsync" />
    <BoardReplayPanel BoardId="BoardData.Id" IsOpen="ShowReplayPanel" OnClose="() => ShowReplayPanel = false" />
}

@code {
    [Parameter]
    public string BoardId { get; set; } = string.Empty;

    private BoardDto? BoardData;
    private IReadOnlyList<ActivityEntryDto> RecentActivity = [];
    private bool IsLoading = true;
    private IDisposable? newTaskRegistration;
    private TaskCardDto? DraggedTask;
    private TaskDrawer? taskDrawer;
    private TaskFilterCriteria Filter = new();
    private IReadOnlyList<BoardMemberDto> BoardMembers = [];
    private IReadOnlyList<BoardPresenceDto> ActiveUsers = [];
    private RealtimeConnectionState ConnectionState = RealtimeConnectionState.Disconnected;
    private bool ShowReplayPanel;
    private IJSObjectReference? realtimeModule;
    private DotNetObjectReference<Board>? boardReference;
    private bool RealtimeInitialized;
    private IDisposable? boardReplayRegistration;

    protected override async Task OnInitializedAsync()
    {
        await LoadBoardDataAsync();

        if (BoardData is not null)
        {
            newTaskRegistration = AppActions.RegisterNewTaskHandler(OpenCreateTaskDrawerAsync);
            boardReplayRegistration = AppActions.RegisterBoardReplayHandler(OpenReplayAsync);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitializeRealtimeAsync();
        }
    }

    private async Task InitializeRealtimeAsync()
    {
        if (RealtimeInitialized || BoardData is null)
            return;

        RealtimeInitialized = true;

        try
        {
            boardReference = DotNetObjectReference.Create(this);
            realtimeModule = await JS.InvokeAsync<IJSObjectReference>("import", "/js/boardRealtime.js");
            await realtimeModule.InvokeVoidAsync("connect", BoardData.Id, boardReference);
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "Board realtime connection failed for board {BoardId}.", BoardData?.Id);
            ConnectionState = RealtimeConnectionState.Disconnected;
        }
    }

    [JSInvokable]
    public async Task HandleBoardActivityRecorded(string boardId, string summary)
    {
        if (!IsCurrentBoard(boardId))
            return;

        await InvokeAsync(async () =>
        {
            await LoadBoardDataAsync();
            StateHasChanged();
        });
    }

    [JSInvokable]
    public Task HandlePresenceChanged(BoardPresenceDto[] users)
    {
        return InvokeAsync(() =>
        {
            ActiveUsers = users;
            StateHasChanged();
        });
    }

    [JSInvokable]
    public Task HandleConnectionStateChanged(string state)
    {
        return InvokeAsync(() =>
        {
            ConnectionState = Enum.TryParse<RealtimeConnectionState>(state, ignoreCase: true, out var parsed)
                ? parsed
                : RealtimeConnectionState.Disconnected;
            StateHasChanged();
        });
    }

    [JSInvokable]
    public Task HandleUserStartedEditing(string userName, string taskId, string fieldName)
    {
        if (!Guid.TryParse(taskId, out var parsedTaskId))
            return Task.CompletedTask;

        return InvokeAsync(() =>
        {
            taskDrawer?.ApplyUserStartedEditing(userName, parsedTaskId, fieldName);
            StateHasChanged();
        });
    }

    [JSInvokable]
    public Task HandleUserStoppedEditing(string userName, string taskId, string fieldName)
    {
        if (!Guid.TryParse(taskId, out var parsedTaskId))
            return Task.CompletedTask;

        return InvokeAsync(() =>
        {
            taskDrawer?.ApplyUserStoppedEditing(userName, parsedTaskId, fieldName);
            StateHasChanged();
        });
    }

    private async Task LoadBoardDataAsync()
    {
        IsLoading = true;
        
        // If "demo" is passed, use the seeded demo board ID
        if (BoardId.Equals("demo", StringComparison.OrdinalIgnoreCase))
        {
            BoardData = await BoardService.GetBoardAsync(SeedData.BoardId);
        }
        else if (Guid.TryParse(BoardId, out var id))
        {
            BoardData = await BoardService.GetBoardAsync(id);
        }

        RecentActivity = BoardData is null
            ? []
            : await BoardService.GetRecentActivityForBoardAsync(BoardData.Id);

        BoardMembers = BoardData is null
            ? []
            : await BoardService.GetBoardMembersAsync(BoardData.Id);

        IsLoading = false;
    }

    private void HandleFilterChanged(TaskFilterCriteria criteria)
    {
        Filter = criteria;
    }

    private IEnumerable<TaskCardDto> GetFilteredTasks(BoardColumnDto col)
    {
        var query = col.Tasks.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(Filter.SearchText))
        {
            var search = Filter.SearchText.ToLowerInvariant();
            query = query.Where(t => t.Title.ToLowerInvariant().Contains(search));
        }

        if (Filter.Priority.HasValue)
        {
            query = query.Where(t => t.Priority == Filter.Priority.Value);
        }

        if (!string.IsNullOrEmpty(Filter.AssigneeUserId))
        {
            if (Filter.AssigneeUserId == "unassigned")
            {
                query = query.Where(t => string.IsNullOrEmpty(t.AssigneeUserId));
            }
            else
            {
                query = query.Where(t => t.AssigneeUserId == Filter.AssigneeUserId);
            }
        }

        return query.OrderBy(t => t.SortOrder);
    }
    
    private void HandleDragStart(TaskCardDto task)
    {
        DraggedTask = task;
    }

    private async Task HandleDropAsync(Guid targetColumnId)
    {
        if (BoardData is null || DraggedTask is null || DraggedTask.ColumnId == targetColumnId)
            return;

        var targetColumn = BoardData.Columns.FirstOrDefault(c => c.Id == targetColumnId);
        if (targetColumn is null)
            return;

        await BoardService.MoveTaskAsync(DraggedTask.Id, targetColumnId, -1);

        var summary = $"Moved {DraggedTask.Title} to {targetColumn.Name}.";
        DraggedTask = null;
        await LoadBoardDataAsync();
        await NotifyBoardChangedAsync("TaskMoved", summary);
    }

    private async Task OpenTaskDrawer(Guid taskId)
    {
        if (taskDrawer != null)
        {
            await taskDrawer.OpenAsync(taskId);
        }
    }

    private async Task OpenCreateTaskDrawerAsync()
    {
        if (taskDrawer is not null && BoardData is not null)
        {
            await taskDrawer.OpenForCreateAsync(BoardData.Id);
        }
    }

    private async Task HandleTaskSavedAsync(TaskDrawerSavedArgs args)
    {
        await LoadBoardDataAsync();
        await NotifyBoardChangedAsync(args.EventType, args.Summary);
    }

    private async Task HandleTaskFieldFocusedAsync(TaskFieldEditArgs args)
    {
        if (realtimeModule is null)
            return;

        await realtimeModule.InvokeVoidAsync("startEditing", args.BoardId, args.TaskId, args.FieldName);
    }

    private async Task HandleTaskFieldBlurredAsync(TaskFieldEditArgs args)
    {
        if (realtimeModule is null)
            return;

        await realtimeModule.InvokeVoidAsync("stopEditing", args.BoardId, args.TaskId, args.FieldName);
    }

    private void ToggleReplay()
    {
        ShowReplayPanel = !ShowReplayPanel;
    }

    private Task OpenReplayAsync()
    {
        ShowReplayPanel = true;
        return InvokeAsync(StateHasChanged);
    }

    private Task NotifyBoardChangedAsync(string eventType, string summary)
    {
        if (BoardData is null)
            return Task.CompletedTask;

        return BoardUpdates.NotifyBoardChangedAsync(new BoardRealtimeEvent(
            BoardData.Id,
            eventType,
            summary,
            DateTime.UtcNow));
    }

    private static string GetInitials(string value)
    {
        var parts = value
            .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Take(2)
            .Select(part => part[0].ToString().ToUpperInvariant())
            .ToArray();

        return parts.Length == 0 ? "?" : string.Concat(parts);
    }

    private static string FormatRelativeTime(DateTime createdAtUtc)
    {
        var timestamp = createdAtUtc.Kind == DateTimeKind.Utc
            ? createdAtUtc
            : DateTime.SpecifyKind(createdAtUtc, DateTimeKind.Utc);
        var elapsed = DateTime.UtcNow - timestamp;

        if (elapsed < TimeSpan.FromMinutes(1))
            return "just now";

        if (elapsed < TimeSpan.FromHours(1))
            return $"{Math.Max(1, (int)elapsed.TotalMinutes)}m ago";

        if (elapsed < TimeSpan.FromDays(1))
            return $"{Math.Max(1, (int)elapsed.TotalHours)}h ago";

        return $"{Math.Max(1, (int)elapsed.TotalDays)}d ago";
    }

    private bool IsCurrentBoard(string boardId)
    {
        return BoardData is not null
            && Guid.TryParse(boardId, out var parsedBoardId)
            && parsedBoardId == BoardData.Id;
    }

    public async ValueTask DisposeAsync()
    {
        if (realtimeModule is not null && BoardData is not null)
        {
            try
            {
                await realtimeModule.InvokeVoidAsync("disconnect", BoardData.Id);
                await realtimeModule.DisposeAsync();
            }
            catch (JSDisconnectedException ex)
            {
                Logger.LogDebug(ex, "Browser disconnected before board realtime cleanup completed.");
            }
            catch (JSException ex)
            {
                Logger.LogDebug(ex, "Board realtime cleanup failed for board {BoardId}.", BoardData.Id);
            }
        }

        boardReference?.Dispose();
        
        newTaskRegistration?.Dispose();
        boardReplayRegistration?.Dispose();
    }
}

@page "/"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@implements IDisposable
@using FlowBoard.Application.Interfaces
@using FlowBoard.Application.DTOs
@using FlowBoard.Infrastructure.Data
@using FlowBoard.Web.Components.UI
@using FlowBoard.Web.Hubs
@using FlowBoard.Web.Services
@inject IDashboardService DashboardService
@inject AppActionDispatcher AppActions
@inject BoardUpdateNotifier BoardUpdates

<PageTitle>FlowBoard</PageTitle>

@if (_dashboard == null)
{
    <p>Loading...</p>
}
else
{
    <section class="dashboard-grid">
        <article class="metric-card">
            <span class="metric-label">Assigned to me</span>
            <strong>@_dashboard.AssignedToMe</strong>
            <small>@_dashboard.DueThisWeek due this week</small>
        </article>

        <article class="metric-card @(_dashboard.Overdue > 0 ? "warning" : "")">
            <span class="metric-label">Overdue</span>
            <strong>@_dashboard.Overdue</strong>
            <small>Needs review today</small>
        </article>

        <article class="metric-card">
            <span class="metric-label">Completed</span>
            <strong>@_dashboard.CompletedLast7Days</strong>
            <small>Last 7 days</small>
        </article>

        <article class="metric-card success">
            <span class="metric-label">Live users</span>
            <strong>@_dashboard.LiveUsers</strong>
            <small>Viewing active boards</small>
        </article>
    </section>

    <section class="workspace-layout">
        <article class="board-preview">
            @if (_dashboard.RecentBoard != null)
            {
                <div class="section-heading">
                    <div>
                        <p class="eyebrow">Product Launch</p>
                        <h2>@_dashboard.RecentBoard.Name</h2>
                    </div>
                    <span class="connection-pill">Connected</span>
                </div>

                <div class="kanban-preview" aria-label="Kanban board preview">
                    @foreach (var column in _dashboard.RecentBoard.Columns)
                    {
                        <section class="kanban-column">
                            <header>
                                <h3>@column.Name</h3>
                                <span>@column.Tasks.Count</span>
                            </header>

                            @foreach (var task in column.Tasks)
                            {
                                <article class="task-card">
                                    <span class="priority @task.Priority.ToString().ToLower()">@task.Priority</span>
                                    <h4>@task.Title</h4>
                                    <p>@(task.AssigneeName ?? "Unassigned")</p>
                                </article>
                            }
                        </section>
                    }
                </div>
            }
            else
            {
                <p>No active boards.</p>
            }
        </article>

        <aside class="activity-panel">
            <div class="section-heading compact">
                <div>
                    <p class="eyebrow">Replay timeline</p>
                    <h2>Recent activity</h2>
                </div>
            </div>

            <ol class="activity-list">
                @foreach (var activity in _dashboard.RecentActivity)
                {
                    <li>
                        <span>@activity.CreatedAtUtc.ToLocalTime().ToString("HH:mm")</span>
                        <p>@activity.Summary</p>
                    </li>
                }
            </ol>

            <button type="button" class="secondary-action">Replay last 30 minutes</button>
        </aside>
    </section>

    @if (_dashboard.RecentBoard is not null)
    {
        <TaskDrawer @ref="_taskDrawer" OnTaskSaved="HandleTaskSavedAsync" />
    }
}

@code {
    private DashboardSummaryDto? _dashboard;
    private TaskDrawer? _taskDrawer;
    private IDisposable? _newTaskRegistration;
    private Guid? _activeCreateBoardId;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardAsync();

        if (_dashboard?.RecentBoard is not null)
        {
            _newTaskRegistration = AppActions.RegisterNewTaskHandler(OpenCreateTaskDrawerAsync);
        }
    }

    private async Task LoadDashboardAsync()
    {
        _dashboard = await DashboardService.GetDashboardAsync(
            SeedData.DemoUserId,
            SeedData.WorkspaceId);
    }

    private async Task OpenCreateTaskDrawerAsync()
    {
        if (_taskDrawer is null || _dashboard?.RecentBoard is null)
            return;

        _activeCreateBoardId = _dashboard.RecentBoard.Id;
        await _taskDrawer.OpenForCreateAsync(_dashboard.RecentBoard.Id);
    }

    private async Task HandleTaskSavedAsync(TaskDrawerSavedArgs args)
    {
        var boardId = _activeCreateBoardId;
        await LoadDashboardAsync();

        if (boardId.HasValue)
        {
            await BoardUpdates.NotifyBoardChangedAsync(new BoardRealtimeEvent(
                boardId.Value,
                args.EventType,
                args.Summary,
                DateTime.UtcNow));
        }

        _activeCreateBoardId = null;
    }

    public void Dispose()
    {
        _newTaskRegistration?.Dispose();
    }
}

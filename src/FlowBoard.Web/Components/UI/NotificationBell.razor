@rendermode InteractiveServer
@using FlowBoard.Application.DTOs
@using FlowBoard.Application.Interfaces
@using FlowBoard.Domain.Enums
@implements IAsyncDisposable
@inject INotificationService Notifications
@inject ICurrentUserService CurrentUser
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="notification-bell-wrap" @onclick:stopPropagation>
    <button type="button"
            class="utility-button notification-bell"
            title="@TooltipText"
            aria-label="Open notifications"
            aria-haspopup="true"
            aria-expanded="@IsOpen.ToString().ToLowerInvariant()"
            @onclick="ToggleAsync">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
            <path d="M9 1.5c-2.5 0-4.5 2-4.5 4.5v2.6c0 .9-.4 1.8-1 2.4l-.7.7h12.4l-.7-.7c-.6-.6-1-1.5-1-2.4V6c0-2.5-2-4.5-4.5-4.5Z" stroke="currentColor" stroke-width="1.4"/>
            <path d="M7.2 14a1.8 1.8 0 0 0 3.6 0" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
        </svg>
        @if (UnreadCount > 0)
        {
            <span class="notification-badge">@(UnreadCount > 99 ? "99+" : UnreadCount.ToString())</span>
        }
    </button>

    @if (IsOpen)
    {
        <div class="notification-panel" role="dialog" aria-label="Notifications">
            <header class="notification-header">
                <h4>Notifications</h4>
                @if (UnreadCount > 0)
                {
                    <button type="button" class="notification-link" @onclick="MarkAllReadAsync">Mark all read</button>
                }
            </header>

            @if (Items.Count == 0)
            {
                <div class="notification-empty">
                    <p>No notifications yet.</p>
                    <small>Assignments, @@mentions, and overdue reminders land here.</small>
                </div>
            }
            else
            {
                <ol class="notification-list">
                    @foreach (var item in Items)
                    {
                        <li class="notification-item @(item.IsRead ? "is-read" : "is-unread")" @key="item.Id">
                            <button type="button" class="notification-item-button" @onclick="@(() => OnItemClickAsync(item))">
                                <span class="notification-icon @TypeClass(item.Type)" aria-hidden="true">@TypeGlyph(item.Type)</span>
                                <div class="notification-content">
                                    <strong>@item.Title</strong>
                                    <p>@item.Body</p>
                                    <small>@FormatRelative(item.CreatedAtUtc)</small>
                                </div>
                                @if (!item.IsRead)
                                {
                                    <span class="notification-dot" aria-hidden="true"></span>
                                }
                            </button>
                        </li>
                    }
                </ol>
            }

            <footer class="notification-footer">
                <a href="/notifications" @onclick="Close">See all notifications →</a>
            </footer>
        </div>
    }
</div>

@code {
    private bool IsOpen;
    private IReadOnlyList<NotificationDto> Items = [];
    private int UnreadCount;
    
    private DotNetObjectReference<NotificationBell>? _dotNetRef;
    private IJSObjectReference? _realtimeModule;

    private string TooltipText => UnreadCount switch
    {
        0 => "No new notifications",
        1 => "1 unread notification",
        _ => $"{UnreadCount} unread notifications"
    };

    protected override async Task OnInitializedAsync()
    {
        await RefreshCountAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            try
            {
                _realtimeModule = await JS.InvokeAsync<IJSObjectReference>("import", "/js/notificationRealtime.js");
                await _realtimeModule.InvokeVoidAsync("connect", _dotNetRef);
            }
            catch
            {
                // Ignore JS errors if SignalR is unavailable
            }
        }
    }

    [JSInvokable]
    public Task HandleNotificationCountChanged(int count)
    {
        UnreadCount = count;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task RefreshCountAsync()
    {
        var userId = CurrentUser.UserId;
        if (string.IsNullOrEmpty(userId)) return;

        UnreadCount = await Notifications.GetUnreadCountAsync(userId);
        StateHasChanged();
    }

    private async Task ToggleAsync()
    {
        if (IsOpen)
        {
            Close();
            return;
        }

        var userId = CurrentUser.UserId;
        if (string.IsNullOrEmpty(userId)) return;

        // Lazy-materialize overdue reminders on every open. The service
        // is idempotent: no duplicate rows even on rapid re-open.
        await Notifications.EnsureOverdueRemindersAsync(userId);

        var list = await Notifications.GetForUserAsync(userId, take: 10);
        Items = list.Items;
        UnreadCount = list.UnreadCount;
        IsOpen = true;
    }

    private void Close() => IsOpen = false;

    private async Task MarkAllReadAsync()
    {
        var userId = CurrentUser.UserId;
        if (string.IsNullOrEmpty(userId)) return;

        await Notifications.MarkAllReadAsync(userId);
        await RefreshOpenedAsync(userId);
    }

    private async Task OnItemClickAsync(NotificationDto item)
    {
        var userId = CurrentUser.UserId;
        if (string.IsNullOrEmpty(userId)) return;

        if (!item.IsRead)
        {
            await Notifications.MarkReadAsync(item.Id, userId);
        }

        Close();

        // Best-effort navigation: notifications about a specific task
        // route to that task's drawer via the standard board route.
        // We don't know which board hosts the task here, but the demo
        // board is the only one — extending to multi-board would store
        // a board id alongside the task id on the Notification entity.
        if (item.RelatedTaskId.HasValue)
        {
            Navigation.NavigateTo("/boards/demo");
        }
        else
        {
            Navigation.NavigateTo("/notifications");
        }
    }

    private async Task RefreshOpenedAsync(string userId)
    {
        var list = await Notifications.GetForUserAsync(userId, take: 10);
        Items = list.Items;
        UnreadCount = list.UnreadCount;
        StateHasChanged();
    }

    private static string TypeGlyph(NotificationType type) => type switch
    {
        NotificationType.TaskAssigned => "👤",
        NotificationType.TaskOverdue => "⏰",
        NotificationType.CommentMention => "@",
        NotificationType.MemberInvited => "✉",
        NotificationType.BoardShared => "🔗",
        _ => "•"
    };

    private static string TypeClass(NotificationType type) => type switch
    {
        NotificationType.TaskAssigned => "type-assigned",
        NotificationType.TaskOverdue => "type-overdue",
        NotificationType.CommentMention => "type-mention",
        _ => "type-other"
    };

    private static string FormatRelative(DateTime createdAtUtc)
    {
        var ts = createdAtUtc.Kind == DateTimeKind.Utc
            ? createdAtUtc
            : DateTime.SpecifyKind(createdAtUtc, DateTimeKind.Utc);
        var elapsed = DateTime.UtcNow - ts;

        if (elapsed < TimeSpan.FromMinutes(1)) return "just now";
        if (elapsed < TimeSpan.FromHours(1)) return $"{Math.Max(1, (int)elapsed.TotalMinutes)}m ago";
        if (elapsed < TimeSpan.FromDays(1)) return $"{Math.Max(1, (int)elapsed.TotalHours)}h ago";
        return $"{Math.Max(1, (int)elapsed.TotalDays)}d ago";
    }

    public async ValueTask DisposeAsync()
    {
        if (_realtimeModule is not null)
        {
            try
            {
                await _realtimeModule.InvokeVoidAsync("disconnect");
                await _realtimeModule.DisposeAsync();
            }
            catch
            {
                // Ignore errors during disposal
            }
        }
        
        _dotNetRef?.Dispose();
    }
}

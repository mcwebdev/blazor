@using FlowBoard.Application.DTOs
@using FlowBoard.Application.Interfaces
@using FlowBoard.Domain.Enums
@implements IAsyncDisposable
@inject IBoardService BoardService
@inject ICurrentUserService CurrentUserService
@inject IJSRuntime JS

<div class="task-drawer-backdrop @(IsOpen ? "open" : "")" @onclick="CloseAsync"></div>
<div class="task-drawer @(IsOpen ? "open" : "")">
    @if (Task != null)
    {
        <div class="drawer-header">
            <h3>@(IsCreateMode ? "New Task" : "Edit Task")</h3>
            <button type="button" class="close-btn" @onclick="CloseAsync">x</button>
        </div>
        <div class="drawer-body">
            @if (IsCreateMode && ShowDraftRestorePrompt)
            {
                <div class="draft-restore-banner" role="status">
                    <span>You have an unsaved draft for this board. Restore it?</span>
                    <span>
                        <button type="button" @onclick="RestoreDraftAsync">Restore</button>
                        <button type="button" class="draft-discard" @onclick="DismissDraftPromptAsync">Discard</button>
                    </span>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(ValidationMessage))
            {
                <div class="alert-danger">@ValidationMessage</div>
            }

            <div class="form-group">
                <label for="task-title-input">Title</label>
                <input id="task-title-input" name="task-title" type="text" class="form-control" @bind="Task.Title" @bind:event="oninput" @onfocus="HandleTitleFocus" @onblur="HandleTitleBlur" @onkeyup="HandleDraftFieldChanged" />
                @if (ActiveEditors.TryGetValue("Title", out var titleEditors) && titleEditors.Any())
                {
                    <div class="field-editing-indicator" style="font-size: 0.8rem; color: #6c757d; margin-top: 4px;">
                        <i class="bi bi-pencil-fill"></i> @string.Join(", ", titleEditors) @(titleEditors.Count == 1 ? "is" : "are") editing
                    </div>
                }
            </div>

            <div class="form-group">
                <label for="task-description-input">Description</label>
                <textarea id="task-description-input" name="task-description" class="form-control" rows="4" @bind="Task.Description" @bind:event="oninput" @onfocus="HandleDescriptionFocus" @onblur="HandleDescriptionBlur" @onkeyup="HandleDraftFieldChanged"></textarea>
                @if (ActiveEditors.TryGetValue("Description", out var descEditors) && descEditors.Any())
                {
                    <div class="field-editing-indicator" style="font-size: 0.8rem; color: #6c757d; margin-top: 4px;">
                        <i class="bi bi-pencil-fill"></i> @string.Join(", ", descEditors) @(descEditors.Count == 1 ? "is" : "are") editing
                    </div>
                }
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="task-priority-input">Priority</label>
                    <select id="task-priority-input" name="task-priority" class="form-control" @bind="Task.Priority">
                        @foreach (var priority in Enum.GetValues<TaskPriority>())
                        {
                            <option value="@priority">@priority</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label for="task-status-input">Status</label>
                    <select id="task-status-input" name="task-status" class="form-control" @bind="Task.Status">
                        @foreach (var status in AvailableStatuses)
                        {
                            <option value="@status">@FormatStatus(status)</option>
                        }
                    </select>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="task-assignee-input">Assignee</label>
                    <select id="task-assignee-input" name="task-assignee" class="form-control" @bind="Task.AssigneeUserId">
                        <option value="">Unassigned</option>
                        @foreach (var member in BoardMembers)
                        {
                            <option value="@member.UserId">@member.DisplayName</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label for="task-due-date-input">Due date</label>
                    <input id="task-due-date-input" name="task-due-date" type="date" class="form-control" @bind="Task.DueDateUtc" @bind:format="yyyy-MM-dd" />
                </div>
            </div>

            @if (!IsCreateMode)
            {
                <div class="form-group task-labels-select" style="margin-top: 16px;">
                    <label>Labels</label>
                    <div style="display: flex; gap: 8px; flex-wrap: wrap; margin-top: 4px;">
                        @foreach (var label in AvailableLabels)
                        {
                            var isApplied = Task.Labels.Any(l => l.Id == label.Id);
                            <button type="button" 
                                    class="btn btn-sm @(isApplied ? "" : "btn-outline-secondary")" 
                                    style="@(isApplied ? $"background-color: {label.Color}; color: #fff; border-color: {label.Color};" : "")"
                                    @onclick="() => ToggleLabelAsync(label, !isApplied)">
                                @label.Name
                            </button>
                        }
                    </div>
                </div>

                <hr />
                <div class="task-checklists">
                    <h4>Checklist</h4>
                    <div class="checklist-items">
                        @foreach (var item in Task.Checklists.OrderBy(c => c.SortOrder))
                        {
                            <div class="checklist-item" style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
                                <input type="checkbox" id="chk-@item.Id" checked="@item.IsComplete" @onchange="@(e => ToggleChecklistAsync(item.Id, (bool)(e.Value ?? false)))" />
                                <label for="chk-@item.Id" style="@(item.IsComplete ? "text-decoration: line-through; color: #666; margin: 0;" : "margin: 0;")">@item.Text</label>
                            </div>
                        }
                    </div>
                    <div class="add-checklist-item" style="display: flex; gap: 8px; margin-top: 8px;">
                        <input type="text" class="form-control" placeholder="Add an item..." @bind="NewChecklistText" @bind:event="oninput" @onkeyup="HandleChecklistKeyPress" style="flex: 1;" />
                        <button type="button" class="btn btn-sm btn-secondary" @onclick="AddChecklistAsync" disabled="@string.IsNullOrWhiteSpace(NewChecklistText)">Add</button>
                    </div>
                </div>

                <hr />
                <div class="task-comments">
                    <h4>Comments</h4>
                    <div class="comments-list" style="display: flex; flex-direction: column; gap: 12px; margin-bottom: 12px;">
                        @foreach (var comment in Task.Comments.OrderBy(c => c.CreatedAtUtc))
                        {
                            <div class="comment-bubble" style="background: #f8f9fa; padding: 12px; border-radius: 8px; border: 1px solid #e9ecef;">
                                <div class="comment-header" style="display: flex; justify-content: space-between; font-size: 0.85rem; color: #6c757d; margin-bottom: 4px;">
                                    <span class="comment-author" style="font-weight: 600; color: #495057;">@comment.AuthorName</span>
                                    <span class="comment-time">@comment.CreatedAtUtc.ToString("g")</span>
                                </div>
                                <div class="comment-body" style="white-space: pre-wrap; margin: 0;">@comment.Body</div>
                            </div>
                        }
                    </div>
                    <div class="add-comment" style="display: flex; flex-direction: column; gap: 8px;">
                        <textarea class="form-control" rows="2" placeholder="Write a comment..." @bind="NewCommentText" @bind:event="oninput"></textarea>
                        <div style="display: flex; justify-content: flex-end;">
                            <button type="button" class="btn btn-sm btn-primary" @onclick="AddCommentAsync" disabled="@string.IsNullOrWhiteSpace(NewCommentText)">Comment</button>
                        </div>
                    </div>
                </div>
            }
        </div>
        <div class="drawer-footer">
            <button type="button" class="btn btn-secondary" @onclick="CloseAsync" disabled="@IsSaving">Cancel</button>
            <button type="button" class="btn btn-primary" @onclick="SaveAsync" disabled="@IsSaving">
                @(IsSaving ? "Saving..." : IsCreateMode ? "Create Task" : "Save Changes")
            </button>
        </div>
    }
    else if (IsLoading)
    {
        <div class="drawer-body">
            <p>Loading task details...</p>
        </div>
    }
</div>

@* Conflict Resolution Modal *@
@if (ShowConflictModal)
{
    <div class="conflict-modal-backdrop">
        <div class="conflict-modal">
            <div class="conflict-modal-icon">⚠️</div>
            <h3>Edit Conflict Detected</h3>
            <p>Another user has saved changes to this task since you opened it. Your version is now stale.</p>
            <div class="conflict-modal-actions">
                <button type="button" class="btn btn-danger" @onclick="HandleConflictOverwrite">
                    <i class="bi bi-arrow-repeat"></i> Overwrite with My Changes
                </button>
                <button type="button" class="btn btn-secondary" @onclick="HandleConflictDiscard">
                    Discard My Changes
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid? BoardId { get; set; }

    [Parameter]
    public EventCallback<TaskDrawerSavedArgs> OnTaskSaved { get; set; }

    [Parameter]
    public EventCallback<TaskFieldEditArgs> OnFieldFocused { get; set; }

    [Parameter]
    public EventCallback<TaskFieldEditArgs> OnFieldBlurred { get; set; }

    // Fired after the drawer enqueues a create-task action to localStorage
    // (e.g. server rejected with a connection failure). Reports the new
    // pending count so the board page can update the connection badge.
    [Parameter]
    public EventCallback<int> OnDraftQueued { get; set; }

    public bool IsOpen { get; private set; }
    public TaskDetailDto? Task { get; private set; }
    private IReadOnlyList<BoardMemberDto> BoardMembers = [];
    private bool IsCreateMode;
    private bool IsLoading;
    private bool IsSaving;
    private string? ValidationMessage;
    private bool ShowDraftRestorePrompt;
    private TaskDraftSnapshot? PendingDraft;
    private IJSObjectReference? offlineModule;

    private IReadOnlyList<TaskLabelDto> AvailableLabels = [];
    private string NewChecklistText = "";
    private string NewCommentText = "";

    private Dictionary<string, List<string>> ActiveEditors = new();

    private sealed record TaskDraftSnapshot(
        string Title,
        string? Description,
        TaskPriority Priority,
        TaskItemStatus Status,
        string? AssigneeUserId,
        DateTime? DueDateUtc,
        DateTime SavedAtUtc);

    private static readonly TaskItemStatus[] AvailableStatuses =
    [
        TaskItemStatus.Open,
        TaskItemStatus.InProgress,
        TaskItemStatus.InReview,
        TaskItemStatus.Done
    ];

    public async Task OpenAsync(Guid taskId)
    {
        IsOpen = true;
        IsLoading = true;
        IsCreateMode = false;
        ValidationMessage = null;
        Task = null;
        BoardMembers = [];
        NewChecklistText = "";
        NewCommentText = "";
        ActiveEditors = new();
        StateHasChanged();

        Task = await BoardService.GetTaskAsync(taskId);
        BoardMembers = Task is null
            ? []
            : await BoardService.GetBoardMembersAsync(Task.BoardId);
        
        AvailableLabels = Task is null
            ? []
            : await BoardService.GetLabelsForBoardAsync(Task.BoardId);

        IsLoading = false;
        StateHasChanged();
    }

    public async Task OpenForCreateAsync(Guid boardId)
    {
        IsOpen = true;
        IsCreateMode = true;
        IsLoading = true;
        ValidationMessage = null;
        Task = null;
        BoardMembers = [];
        ShowDraftRestorePrompt = false;
        PendingDraft = null;
        StateHasChanged();

        BoardMembers = await BoardService.GetBoardMembersAsync(boardId);
        AvailableLabels = await BoardService.GetLabelsForBoardAsync(boardId);

        Task = new TaskDetailDto
        {
            BoardId = boardId,
            Title = string.Empty,
            Priority = TaskPriority.Medium,
            Status = TaskItemStatus.Open
        };

        IsLoading = false;
        StateHasChanged();

        // Check for an unsaved draft for this board. We surface a prompt
        // instead of auto-restoring so the user is never silently confused
        // about why fields are populated.
        try
        {
            await EnsureOfflineModuleAsync();
            if (offlineModule is not null)
            {
                var draft = await offlineModule.InvokeAsync<TaskDraftSnapshot?>("loadDraft", boardId);
                if (draft is not null && !string.IsNullOrWhiteSpace(draft.Title))
                {
                    PendingDraft = draft;
                    ShowDraftRestorePrompt = true;
                    StateHasChanged();
                }
            }
        }
        catch (JSException)
        {
            // localStorage unavailable; non-fatal.
        }
    }

    private async ValueTask EnsureOfflineModuleAsync()
    {
        if (offlineModule is null)
        {
            try
            {
                offlineModule = await JS.InvokeAsync<IJSObjectReference>("import", "/js/offlineDrafts.js");
            }
            catch (JSException)
            {
                offlineModule = null;
            }
        }
    }

    private async Task RestoreDraftAsync()
    {
        if (Task is null || PendingDraft is null)
            return;

        Task.Title = PendingDraft.Title;
        Task.Description = PendingDraft.Description;
        Task.Priority = PendingDraft.Priority;
        Task.Status = PendingDraft.Status;
        Task.AssigneeUserId = PendingDraft.AssigneeUserId;
        Task.DueDateUtc = PendingDraft.DueDateUtc;

        ShowDraftRestorePrompt = false;
        PendingDraft = null;
        StateHasChanged();

        await System.Threading.Tasks.Task.CompletedTask;
    }

    private async Task DismissDraftPromptAsync()
    {
        ShowDraftRestorePrompt = false;
        PendingDraft = null;

        if (Task is not null && offlineModule is not null)
        {
            try
            {
                await offlineModule.InvokeVoidAsync("clearDraft", Task.BoardId);
            }
            catch (JSException) { /* non-fatal */ }
        }

        StateHasChanged();
    }

    private async Task HandleDraftFieldChanged()
    {
        if (!IsCreateMode || Task is null || offlineModule is null)
            return;

        // Don't autosave a truly empty draft: that just creates noise in
        // localStorage with no value to the user.
        if (string.IsNullOrWhiteSpace(Task.Title) && string.IsNullOrWhiteSpace(Task.Description))
            return;

        try
        {
            await offlineModule.InvokeVoidAsync("saveDraft", Task.BoardId, new
            {
                title = Task.Title,
                description = Task.Description,
                priority = Task.Priority.ToString(),
                status = Task.Status.ToString(),
                assigneeUserId = Task.AssigneeUserId,
                dueDateUtc = Task.DueDateUtc
            });
        }
        catch (JSException) { /* localStorage may be full or blocked; non-fatal */ }
    }

    public async Task CloseAsync()
    {
        if (!IsCreateMode && Task is not null && _currentlyFocusedField is not null)
        {
            await OnFieldBlurred.InvokeAsync(new TaskFieldEditArgs(Task.BoardId, Task.Id, _currentlyFocusedField));
        }

        IsOpen = false;
        Task = null;
        IsCreateMode = false;
        IsSaving = false;
        ShowConflictModal = false;
        ValidationMessage = null;
        _currentlyFocusedField = null;
        ActiveEditors = new();
        StateHasChanged();
    }

    private bool ShowConflictModal;
    private string? _currentlyFocusedField;

    private async Task SaveAsync()
    {
        if (Task is null)
            return;

        if (string.IsNullOrWhiteSpace(Task.Title))
        {
            ValidationMessage = "Task title is required.";
            return;
        }

        IsSaving = true;
        ValidationMessage = null;

        try
        {
            if (IsCreateMode)
            {
                // Stamp a fresh idempotency key. Used both on the normal
                // server call and as the queue entry's id if we have to fall
                // back to localStorage. Either path is safe: the server
                // returns the existing task on the second occurrence.
                var clientRequestId = Guid.NewGuid().ToString("D");

                var created = await BoardService.CreateTaskAsync(new CreateTaskDto
                {
                    BoardId = Task.BoardId,
                    Title = Task.Title,
                    Description = Task.Description,
                    Priority = Task.Priority,
                    Status = Task.Status,
                    AssigneeUserId = Task.AssigneeUserId,
                    DueDateUtc = Task.DueDateUtc,
                    ClientRequestId = clientRequestId
                });

                await ClearDraftAsync(Task.BoardId);
                await OnTaskSaved.InvokeAsync(new TaskDrawerSavedArgs(
                    "TaskCreated",
                    $"Created {created.Title}."));
            }
            else
            {
                await BoardService.UpdateTaskAsync(Task);
                await OnTaskSaved.InvokeAsync(new TaskDrawerSavedArgs(
                    "TaskUpdated",
                    $"Updated {Task.Title.Trim()}."));
            }

            await CloseAsync();
        }
        catch (Microsoft.EntityFrameworkCore.DbUpdateConcurrencyException)
        {
            ShowConflictModal = true;
            IsSaving = false;
        }
        catch (InvalidOperationException ex)
        {
            ValidationMessage = ex.Message;
            IsSaving = false;
        }
        catch (Exception)
        {
            // For create-mode failures we treat the action as queueable:
            // persist to localStorage and let the board reconnect path
            // replay it. Edits/updates are not queued because they depend
            // on a Version token that may be stale by the time we replay.
            if (IsCreateMode)
            {
                var queued = await TryEnqueueDraftAsync();
                if (queued)
                {
                    await ClearDraftAsync(Task.BoardId);
                    await CloseAsync();
                    return;
                }
            }

            ValidationMessage = "Could not save the task. Try again.";
            IsSaving = false;
        }
    }

    private async Task<bool> TryEnqueueDraftAsync()
    {
        if (Task is null)
            return false;

        await EnsureOfflineModuleAsync();
        if (offlineModule is null)
            return false;

        try
        {
            await offlineModule.InvokeVoidAsync("enqueueAction", Task.BoardId, "create-task", new
            {
                title = Task.Title,
                description = Task.Description,
                priority = Task.Priority.ToString(),
                status = Task.Status.ToString(),
                assigneeUserId = Task.AssigneeUserId,
                dueDateUtc = Task.DueDateUtc
            });

            var pending = await offlineModule.InvokeAsync<int>("pendingCount", Task.BoardId);
            await OnDraftQueued.InvokeAsync(pending);
            return true;
        }
        catch (JSException)
        {
            return false;
        }
    }

    private async Task ClearDraftAsync(Guid boardId)
    {
        if (offlineModule is null)
            return;

        try
        {
            await offlineModule.InvokeVoidAsync("clearDraft", boardId);
        }
        catch (JSException) { /* non-fatal */ }
    }

    public async ValueTask DisposeAsync()
    {
        if (offlineModule is not null)
        {
            try
            {
                await offlineModule.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
            catch (JSException) { }
        }
    }

    private async Task HandleConflictOverwrite()
    {
        if (Task is null) return;

        ShowConflictModal = false;
        IsSaving = true;
        ValidationMessage = null;

        try
        {
            await BoardService.ForceUpdateTaskAsync(Task);
            await OnTaskSaved.InvokeAsync(new TaskDrawerSavedArgs(
                "TaskUpdated",
                $"Updated {Task.Title.Trim()} (overwritten)."));
            await CloseAsync();
        }
        catch (Exception ex)
        {
            ValidationMessage = $"Overwrite failed: {ex.Message}";
            IsSaving = false;
        }
    }

    private async Task HandleConflictDiscard()
    {
        ShowConflictModal = false;
        await CloseAsync();
    }

    public void ApplyUserStartedEditing(string userName, Guid taskId, string fieldName)
    {
        if (Task is null || Task.Id != taskId)
            return;

        if (!ActiveEditors.ContainsKey(fieldName))
            ActiveEditors[fieldName] = new();

        if (!ActiveEditors[fieldName].Contains(userName))
            ActiveEditors[fieldName].Add(userName);

        StateHasChanged();
    }

    public void ApplyUserStoppedEditing(string userName, Guid taskId, string fieldName)
    {
        if (Task is null || Task.Id != taskId)
            return;

        if (ActiveEditors.TryGetValue(fieldName, out var editors))
        {
            editors.Remove(userName);
            if (editors.Count == 0)
                ActiveEditors.Remove(fieldName);
        }

        StateHasChanged();
    }

    private async Task HandleFocusAsync(string fieldName)
    {
        _currentlyFocusedField = fieldName;
        if (!IsCreateMode && Task is not null)
        {
            await OnFieldFocused.InvokeAsync(new TaskFieldEditArgs(Task.BoardId, Task.Id, fieldName));
        }
    }

    private async Task HandleBlurAsync(string fieldName)
    {
        _currentlyFocusedField = null;
        if (!IsCreateMode && Task is not null)
        {
            await OnFieldBlurred.InvokeAsync(new TaskFieldEditArgs(Task.BoardId, Task.Id, fieldName));
        }
    }

    private Task HandleTitleFocus() => HandleFocusAsync("Title");
    private Task HandleTitleBlur() => HandleBlurAsync("Title");
    private Task HandleDescriptionFocus() => HandleFocusAsync("Description");
    private Task HandleDescriptionBlur() => HandleBlurAsync("Description");

    private static string FormatStatus(TaskItemStatus status)
    {
        return status switch
        {
            TaskItemStatus.InProgress => "In progress",
            TaskItemStatus.InReview => "In review",
            _ => status.ToString()
        };
    }

    private async Task ToggleChecklistAsync(Guid itemId, bool isComplete)
    {
        if (CurrentUserService.UserId is null) return;
        await BoardService.ToggleChecklistItemAsync(itemId, isComplete, CurrentUserService.UserId);
        var item = Task?.Checklists.FirstOrDefault(c => c.Id == itemId);
        if (item is not null)
        {
            var updatedItem = item with { IsComplete = isComplete };
            var list = Task!.Checklists.ToList();
            var index = list.IndexOf(item);
            list[index] = updatedItem;
            Task.Checklists = list;
        }
    }

    private async Task AddChecklistAsync()
    {
        if (string.IsNullOrWhiteSpace(NewChecklistText) || Task is null || CurrentUserService.UserId is null) return;
        var newItem = await BoardService.AddChecklistItemAsync(Task.Id, NewChecklistText, CurrentUserService.UserId);
        var list = Task.Checklists.ToList();
        list.Add(newItem);
        Task.Checklists = list;
        NewChecklistText = "";
    }

    private async Task HandleChecklistKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await AddChecklistAsync();
        }
    }

    private async Task AddCommentAsync()
    {
        if (string.IsNullOrWhiteSpace(NewCommentText) || Task is null || CurrentUserService.UserId is null) return;
        var newComment = await BoardService.AddCommentAsync(Task.Id, NewCommentText, CurrentUserService.UserId);
        var list = Task.Comments.ToList();
        list.Add(newComment);
        Task.Comments = list;
        NewCommentText = "";
    }

    private async Task ToggleLabelAsync(TaskLabelDto label, bool isApplied)
    {
        if (CurrentUserService.UserId is null || Task is null) return;
        await BoardService.ToggleTaskLabelAsync(Task.Id, label.Id, isApplied, CurrentUserService.UserId);
        
        var list = Task.Labels.ToList();
        if (isApplied)
        {
            if (!list.Any(l => l.Id == label.Id)) list.Add(label);
        }
        else
        {
            var existing = list.FirstOrDefault(l => l.Id == label.Id);
            if (existing != null) list.Remove(existing);
        }
        Task.Labels = list;
    }
}

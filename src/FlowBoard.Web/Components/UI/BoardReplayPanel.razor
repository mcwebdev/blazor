@using FlowBoard.Application.DTOs
@using FlowBoard.Application.Interfaces
@using FlowBoard.Domain.Enums
@inject IBoardService BoardService

<div class="board-replay-panel @(IsOpen ? "open" : "")">
    <header class="replay-header">
        <div>
            <p class="eyebrow">Board replay</p>
            <h3>Activity timeline</h3>
        </div>
        <button type="button" class="close-btn" @onclick="Close">×</button>
    </header>

    <div class="replay-controls">
        <div class="replay-range-selector">
            @foreach (var range in TimeRanges)
            {
                <button type="button"
                        class="btn btn-sm @(SelectedRange == range.Key ? "btn-primary" : "btn-outline-secondary")"
                        @onclick="@(() => SelectRangeAsync(range.Key))">
                    @range.Value
                </button>
            }
        </div>

        @if (AllEvents.Count > 0)
        {
            <div class="replay-filter-row">
                <input type="search"
                       class="replay-search"
                       placeholder="Filter timeline"
                       @bind="SearchText"
                       @bind:event="oninput"
                       @bind:after="ApplyFiltersAsync" />

                <select class="replay-filter-select" @bind="ActorFilter" @bind:after="ApplyFiltersAsync">
                    <option value="">All actors</option>
                    @foreach (var actor in ActorOptions)
                    {
                        <option value="@actor">@actor</option>
                    }
                </select>

                <select class="replay-filter-select" @bind="EventTypeFilter" @bind:after="ApplyFiltersAsync">
                    <option value="">All events</option>
                    @foreach (var eventType in EventTypeOptions)
                    {
                        <option value="@eventType">@FormatEventType(eventType)</option>
                    }
                </select>
            </div>
        }

        <div class="replay-playback">
            <button type="button" class="replay-btn" @onclick="StepBackward" disabled="@(!CanStepBack)" title="Step back">
                ⏮
            </button>
            <button type="button" class="replay-btn play-btn" @onclick="TogglePlayback" title="@(IsPlaying ? "Pause" : "Play")">
                @(IsPlaying ? "⏸" : "▶")
            </button>
            <button type="button" class="replay-btn" @onclick="StepForward" disabled="@(!CanStepForward)" title="Step forward">
                ⏭
            </button>
            <button type="button" class="replay-btn" @onclick="ResetPlayback" title="Reset">
                ↺
            </button>
            <select class="replay-speed-select" @bind="PlaybackSpeed">
                <option value="1">1×</option>
                <option value="2">2×</option>
                <option value="4">4×</option>
            </select>
        </div>
    </div>

    @if (IsLoading)
    {
        <div class="replay-loading">
            <p>Loading events…</p>
        </div>
    }
    else if (Events.Count == 0)
    {
        <div class="replay-empty">
            <p>No activity found in this time range.</p>
        </div>
    }
    else
    {
        <div class="replay-board-preview" aria-label="Replay board projection">
            <div class="replay-preview-header">
                <div>
                    <p class="eyebrow">Projection</p>
                    <strong>@GetProjectionTitle()</strong>
                </div>
                <span>@SelectedEvent?.CreatedAtUtc.ToLocalTime().ToString("HH:mm:ss")</span>
            </div>

            <div class="replay-mini-board">
                @foreach (var column in GetPreviewColumns())
                {
                    <section class="replay-mini-column @(column.IsTarget ? "target" : "") @(column.IsSource ? "source" : "")">
                        <header>
                            <span>@column.Name</span>
                            @if (column.IsSource)
                            {
                                <small>from</small>
                            }
                            else if (column.IsTarget)
                            {
                                <small>to</small>
                            }
                        </header>

                        @if (column.IsTarget && SelectedEvent is not null)
                        {
                            <article class="replay-mini-card">
                                <span>@GetEventIcon(SelectedEvent.EventType)</span>
                                <p>@GetEventSubject(SelectedEvent)</p>
                            </article>
                        }
                    </section>
                }
            </div>
        </div>

        <div class="replay-progress-bar">
            <div class="replay-progress-fill" style="width: @ProgressPercent%"></div>
            <span class="replay-progress-label">@(CurrentIndex + 1) / @Events.Count</span>
        </div>

        <div class="replay-event-list">
            @foreach (var (evt, index) in Events.Select((e, i) => (e, i)))
            {
                var isCurrent = index == CurrentIndex;
                var isPast = index < CurrentIndex;
                <div class="replay-event-item @(isCurrent ? "current" : "") @(isPast ? "past" : "")"
                     @onclick="@(() => JumpTo(index))">
                    <span class="replay-event-icon">@GetEventIcon(evt.EventType)</span>
                    <div class="replay-event-content">
                        <p class="replay-event-summary">@evt.Summary</p>
                        <small class="replay-event-meta">@evt.ActorName · @evt.CreatedAtUtc.ToString("HH:mm:ss")</small>
                    </div>
                </div>
            }
        </div>

        @if (SelectedEvent is not null)
        {
            <div class="replay-event-inspector">
                <h4>Event inspector</h4>
                <div class="inspector-meta">
                    <span class="inspector-badge">@FormatEventType(SelectedEvent.EventType)</span>
                    <span>@SelectedEvent.ActorName</span>
                    <span>@SelectedEvent.CreatedAtUtc.ToString("g")</span>
                </div>
                @if (GetChangeChips(SelectedEvent).Count > 0)
                {
                    <div class="inspector-change-list">
                        @foreach (var chip in GetChangeChips(SelectedEvent))
                        {
                            <span class="change-chip">@chip</span>
                        }
                    </div>
                }
                <div class="inspector-diff">
                    @if (!string.IsNullOrWhiteSpace(SelectedEvent.BeforeJson))
                    {
                        <div class="inspector-section before">
                            <h5>Before</h5>
                            <pre>@FormatJson(SelectedEvent.BeforeJson)</pre>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(SelectedEvent.AfterJson))
                    {
                        <div class="inspector-section after">
                            <h5>After</h5>
                            <pre>@FormatJson(SelectedEvent.AfterJson)</pre>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

@code {
    [Parameter] public Guid BoardId { get; set; }
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private IReadOnlyList<ReplayEventDto> Events = [];
    private IReadOnlyList<ReplayEventDto> AllEvents = [];
    private BoardDto? Board;
    private bool IsLoading;
    private int CurrentIndex;
    private bool IsPlaying;
    private int PlaybackSpeed = 1;
    private string SelectedRange = "30m";
    private string SearchText = string.Empty;
    private string ActorFilter = string.Empty;
    private string EventTypeFilter = string.Empty;
    private System.Timers.Timer? _playTimer;

    private static readonly Dictionary<string, string> TimeRanges = new()
    {
        ["5m"] = "5 min",
        ["30m"] = "30 min",
        ["1d"] = "1 day",
        ["all"] = "All"
    };

    private ReplayEventDto? SelectedEvent => Events.Count > 0 && CurrentIndex >= 0 && CurrentIndex < Events.Count
        ? Events[CurrentIndex]
        : null;

    private IReadOnlyList<string> ActorOptions => AllEvents
        .Select(e => e.ActorName)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Order(StringComparer.OrdinalIgnoreCase)
        .ToList();

    private IReadOnlyList<string> EventTypeOptions => AllEvents
        .Select(e => e.EventType)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Order(StringComparer.OrdinalIgnoreCase)
        .ToList();

    private bool CanStepBack => CurrentIndex > 0;
    private bool CanStepForward => CurrentIndex < Events.Count - 1;
    private double ProgressPercent => Events.Count > 0 ? (double)(CurrentIndex + 1) / Events.Count * 100 : 0;

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && Events.Count == 0 && !IsLoading)
        {
            await LoadEventsAsync();
        }
    }

    private async Task SelectRangeAsync(string range)
    {
        SelectedRange = range;
        StopPlayback();
        CurrentIndex = 0;
        await LoadEventsAsync();
    }

    private async Task LoadEventsAsync()
    {
        IsLoading = true;
        StateHasChanged();

        var since = SelectedRange switch
        {
            "5m" => DateTime.UtcNow.AddMinutes(-5),
            "30m" => DateTime.UtcNow.AddMinutes(-30),
            "1d" => DateTime.UtcNow.AddDays(-1),
            _ => DateTime.MinValue
        };

        Board ??= await BoardService.GetBoardAsync(BoardId);
        AllEvents = await BoardService.GetReplayEventsAsync(BoardId, since);
        ApplyFilters();
        CurrentIndex = 0;
        IsLoading = false;
        StateHasChanged();
    }

    private void ApplyFilters()
    {
        var query = AllEvents.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(SearchText))
        {
            var search = SearchText.Trim();
            query = query.Where(e =>
                e.Summary.Contains(search, StringComparison.OrdinalIgnoreCase)
                || e.EventType.Contains(search, StringComparison.OrdinalIgnoreCase)
                || e.ActorName.Contains(search, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(ActorFilter))
        {
            query = query.Where(e => e.ActorName.Equals(ActorFilter, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(EventTypeFilter))
        {
            query = query.Where(e => e.EventType.Equals(EventTypeFilter, StringComparison.OrdinalIgnoreCase));
        }

        Events = query.ToList();

        if (Events.Count == 0)
        {
            CurrentIndex = 0;
            StopPlayback();
        }
        else if (CurrentIndex >= Events.Count)
        {
            CurrentIndex = Events.Count - 1;
        }
    }

    private Task ApplyFiltersAsync()
    {
        ApplyFilters();
        return Task.CompletedTask;
    }

    private void TogglePlayback()
    {
        if (IsPlaying)
        {
            StopPlayback();
        }
        else
        {
            StartPlayback();
        }
    }

    private void StartPlayback()
    {
        if (Events.Count == 0) return;
        if (CurrentIndex >= Events.Count - 1) CurrentIndex = 0;

        IsPlaying = true;
        _playTimer = new System.Timers.Timer(1000.0 / PlaybackSpeed);
        _playTimer.Elapsed += async (_, _) =>
        {
            await InvokeAsync(() =>
            {
                if (CurrentIndex < Events.Count - 1)
                {
                    CurrentIndex++;
                    StateHasChanged();
                }
                else
                {
                    StopPlayback();
                    StateHasChanged();
                }
            });
        };
        _playTimer.Start();
    }

    private void StopPlayback()
    {
        IsPlaying = false;
        _playTimer?.Stop();
        _playTimer?.Dispose();
        _playTimer = null;
    }

    private void StepForward()
    {
        if (CanStepForward)
        {
            StopPlayback();
            CurrentIndex++;
        }
    }

    private void StepBackward()
    {
        if (CanStepBack)
        {
            StopPlayback();
            CurrentIndex--;
        }
    }

    private void JumpTo(int index)
    {
        StopPlayback();
        CurrentIndex = index;
    }

    private void ResetPlayback()
    {
        StopPlayback();
        CurrentIndex = 0;
    }

    private void Close()
    {
        StopPlayback();
        OnClose.InvokeAsync();
    }

    private IReadOnlyList<PreviewColumn> GetPreviewColumns()
    {
        var boardColumns = Board?.Columns.OrderBy(c => c.SortOrder).ToList() ?? [];
        if (boardColumns.Count == 0)
            return [];

        var beforeColumn = GetJsonValue(SelectedEvent?.BeforeJson, "ColumnName");
        var afterColumn = GetJsonValue(SelectedEvent?.AfterJson, "ColumnName")
            ?? GetJsonValue(SelectedEvent?.AfterJson, "Status");

        if (string.IsNullOrWhiteSpace(beforeColumn) && string.IsNullOrWhiteSpace(afterColumn))
        {
            var fallback = boardColumns.FirstOrDefault(c => c.Tasks.Any(task =>
                SelectedEvent is not null
                && SelectedEvent.Summary.Contains(task.Title, StringComparison.OrdinalIgnoreCase)));
            afterColumn = fallback?.Name ?? boardColumns.First().Name;
        }

        return boardColumns
            .Select(column => new PreviewColumn(
                column.Name,
                MatchesColumn(column.Name, beforeColumn),
                MatchesColumn(column.Name, afterColumn)))
            .ToList();
    }

    private string GetProjectionTitle()
    {
        if (SelectedEvent is null)
            return "No event selected";

        var beforeColumn = GetJsonValue(SelectedEvent.BeforeJson, "ColumnName");
        var afterColumn = GetJsonValue(SelectedEvent.AfterJson, "ColumnName");

        return !string.IsNullOrWhiteSpace(beforeColumn) && !string.IsNullOrWhiteSpace(afterColumn)
            ? $"{beforeColumn} to {afterColumn}"
            : FormatEventType(SelectedEvent.EventType);
    }

    private static IReadOnlyList<string> GetChangeChips(ReplayEventDto evt)
    {
        var chips = new List<string>();
        AddChangeChip(chips, "Title", evt.BeforeJson, evt.AfterJson);
        AddChangeChip(chips, "Priority", evt.BeforeJson, evt.AfterJson);
        AddChangeChip(chips, "Status", evt.BeforeJson, evt.AfterJson);
        AddChangeChip(chips, "AssigneeUserId", evt.BeforeJson, evt.AfterJson, "Assignee");
        AddChangeChip(chips, "DueDateUtc", evt.BeforeJson, evt.AfterJson, "Due date");
        AddChangeChip(chips, "ColumnName", evt.BeforeJson, evt.AfterJson, "Column");

        return chips;
    }

    private static void AddChangeChip(
        ICollection<string> chips,
        string propertyName,
        string? beforeJson,
        string? afterJson,
        string? label = null)
    {
        var before = GetJsonValue(beforeJson, propertyName);
        var after = GetJsonValue(afterJson, propertyName);

        if (string.IsNullOrWhiteSpace(before) && string.IsNullOrWhiteSpace(after))
            return;

        if (string.Equals(before, after, StringComparison.OrdinalIgnoreCase))
            return;

        chips.Add($"{label ?? propertyName}: {FormatValue(before)} -> {FormatValue(after)}");
    }

    private static string GetEventSubject(ReplayEventDto evt)
    {
        var title = GetJsonValue(evt.AfterJson, "Title")
            ?? GetJsonValue(evt.BeforeJson, "Title");

        if (!string.IsNullOrWhiteSpace(title))
            return title;

        var summary = evt.Summary.TrimEnd('.');
        var verbs = new[] { "Created ", "Updated ", "Moved ", "Commented on ", "Added checklist item to " };
        foreach (var verb in verbs)
        {
            if (summary.StartsWith(verb, StringComparison.OrdinalIgnoreCase))
                return summary[verb.Length..];
        }

        return summary;
    }

    private static string FormatEventType(string eventType)
    {
        return string.Concat(eventType.Select((character, index) =>
            index > 0 && char.IsUpper(character) ? $" {character}" : character.ToString()));
    }

    private static bool MatchesColumn(string columnName, string? eventColumn)
    {
        if (string.IsNullOrWhiteSpace(eventColumn))
            return false;

        return columnName.Equals(eventColumn, StringComparison.OrdinalIgnoreCase)
            || columnName.Replace(" ", "", StringComparison.OrdinalIgnoreCase)
                .Equals(eventColumn.Replace(" ", "", StringComparison.OrdinalIgnoreCase), StringComparison.OrdinalIgnoreCase);
    }

    private static string FormatValue(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "empty";

        return value.Length > 28 ? $"{value[..25]}..." : value;
    }

    private static string? GetJsonValue(string? json, string propertyName)
    {
        if (string.IsNullOrWhiteSpace(json))
            return null;

        try
        {
            using var document = System.Text.Json.JsonDocument.Parse(json);
            if (!document.RootElement.TryGetProperty(propertyName, out var property))
                return null;

            return property.ValueKind switch
            {
                System.Text.Json.JsonValueKind.String => property.GetString(),
                System.Text.Json.JsonValueKind.Number => property.GetRawText(),
                System.Text.Json.JsonValueKind.True => "true",
                System.Text.Json.JsonValueKind.False => "false",
                System.Text.Json.JsonValueKind.Null => null,
                _ => property.GetRawText()
            };
        }
        catch
        {
            return null;
        }
    }

    private static string GetEventIcon(string eventType) => eventType switch
    {
        "TaskCreated" => "✨",
        "TaskUpdated" => "✏️",
        "TaskMoved" => "↔️",
        "TaskDeleted" => "🗑️",
        "TaskAssigned" => "👤",
        "TaskCompleted" => "✅",
        "CommentAdded" => "💬",
        "TaskPriorityChanged" => "🔺",
        "TaskDueDateChanged" => "📅",
        _ => "📋"
    };

    private static string FormatJson(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return "";
        try
        {
            var parsed = System.Text.Json.JsonDocument.Parse(json);
            return System.Text.Json.JsonSerializer.Serialize(
                parsed, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch
        {
            return json;
        }
    }

    private sealed record PreviewColumn(string Name, bool IsSource, bool IsTarget);
}
